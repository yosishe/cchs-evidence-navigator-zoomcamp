# Copy to .env locally. Never commit your real key/password.
OPENAI_API_KEY=
ENABLE_PAID_LLM=0
POSTGRES_PASSWORD=
# Optional observed per-million-token prices. Blank means cost is unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=

# Explicit local demonstration/test origin; default user. QA is not satisfaction evidence.
NAVIGATOR_TRAFFIC_ORIGIN=user

# Local course model; no commercial fallback. Download weights only after approval.
OLLAMA_BASE_URL=http://localhost:11434/v1/
# Optional bounded timeout override. 120 is an initial budget, not measured p95.
# Native shell: export this value explicitly; Compose reads .env automatically.
NAVIGATOR_REQUEST_TIMEOUT=
# Host port only; loopback binding and container port 8501 stay fixed.
# Use an available port for a rehearsal alongside the native app.
NAVIGATOR_APP_PORT=8501
